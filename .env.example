
# Paystack: start with a TEST secret key from your Paystack dashboard.
# Never place a secret key in frontend JavaScript or commit a real key.
PAYSTACK_SECRET_KEY=
PAYSTACK_API_BASE_URL=https://api.paystack.co
PAYSTACK_TIMEOUT_SECONDS=15

# Email delivery (optional for local development; configure for production).
MAIL_BACKEND=console
MAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
